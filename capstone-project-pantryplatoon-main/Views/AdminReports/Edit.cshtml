@model Capstone2025_PantryPlatoon.Models.AdminReports

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>AdminReports</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReportId" />
            <div class="form-group">
                <label asp-for="Month" class="control-label"></label>
                <input asp-for="Month" class="form-control" />
                <span asp-validation-for="Month" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalVisits" class="control-label"></label>
                <input asp-for="TotalVisits" class="form-control" />
                <span asp-validation-for="TotalVisits" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalStudentsServed" class="control-label"></label>
                <input asp-for="TotalStudentsServed" class="form-control" />
                <span asp-validation-for="TotalStudentsServed" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RepeatVisitors" class="control-label"></label>
                <input asp-for="RepeatVisitors" class="form-control" />
                <span asp-validation-for="RepeatVisitors" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalItems" class="control-label"></label>
                <input asp-for="TotalItems" class="form-control" />
                <span asp-validation-for="TotalItems" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalWeight" class="control-label"></label>
                <input asp-for="TotalWeight" class="form-control" />
                <span asp-validation-for="TotalWeight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
