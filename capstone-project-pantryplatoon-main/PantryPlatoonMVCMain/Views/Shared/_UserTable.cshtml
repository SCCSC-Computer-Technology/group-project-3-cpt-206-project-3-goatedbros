@model PantryPlatoonMVCMain.ViewModels.UserViewModel

<div class="table-responsive" >
    <table id="userTable" class=" table table-striped table-hover compact">
        <thead class="">
            <tr>
                <th>
                    Username
                </th>
                <th>
                    Roles
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @foreach (ApplicationUser user in Model.Users)
            {
                <tr>
                    <td> @user.UserName </td>
                    <td>
                        @foreach (string roleName in user.RoleNames)
                        {
                            <div>@roleName</div>
                        }
                    </td>
                    <td>
                        <a asp-controller="User" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-success">Edit</a>
                    </td>
                </tr>
            }
        </tbody>

    </table>


</div>