@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="d-flex">
            <li class="nav-item me-2">
                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Profile" title="Manage">Hello, @User.Identity?.Name.Remove(User.Identity.Name.Length-10)!</a>
            </li>
            <li class="nav-item">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="btn btn-outline-light login-btn">Logout</button>
                </form>
            </li>
        </div>
    }
    else
    {
        <div class="d-flex">
            <li class="nav-item me-2">
                <a class="btn btn-outline-light login-btn" asp-area="Identity" asp-page="/Account/Register">Register</a>
            </li>
            <li class="nav-item">
                <a class="btn btn-outline-light login-btn" asp-area="Identity" asp-page="/Account/Login">Login</a>
            </li>
        </div>
    }
</ul>
