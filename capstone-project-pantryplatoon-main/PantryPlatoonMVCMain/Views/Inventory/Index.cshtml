@model PantryPlatoonMVCMain.Util.PaginatedList<PantryPlatoonMVCMain.ViewModels.InventoryItemViewModel>
@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <div class="d-flex align-items-center gap-3">
        <h2>Available Inventory</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Volunteer"))
        {
            <a asp-action="Manage" asp-route-campusId="@ViewData["SelectedCampusId"]" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-cog me-1"></i>Manage
            </a>
        }
    </div>

    <!-- Campus Selector -->
    <div class="campus-selector">
        <div class="campus-info-container" onclick="toggleCampusDropdown()" style="cursor: pointer;">
            <div class="campus-info">
                <small class="text-muted">
                    <i class="fas fa-map-marker-alt"></i> @ViewData["CampusName"]
                    <i class="fas fa-chevron-down ms-1" id="campusChevron"></i>
                </small>
            </div>
        </div>

        <!-- Campus Dropdown (initially hidden) -->
        <div id="campusDropdown" class="campus-dropdown" style="display: none;">
            <div class="dropdown-content">
                <div class="dropdown-header">
                    <strong>Select Campus</strong>
                </div>
                @if (ViewData["AllCampuses"] is List<PantryPlatoonMVCMain.Models.Campus> campuses)
                {
                    @foreach (var campus in campuses)
                    {
                        <form method="post" asp-action="ChangeCampus" class="d-inline">
                            <input type="hidden" name="campusId" value="@campus.CampusId" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="dropdown-item @((int)ViewData["SelectedCampusId"]! == campus.CampusId ? "active" : "")">
                                <i class="fas fa-map-marker-alt me-2"></i>
                                @campus.CampusName
                                @if ((int)ViewData["SelectedCampusId"]! == campus.CampusId)
                                {
                                    <i class="fas fa-check ms-auto text-success"></i>
                                }
                            </button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Generic Success Message (changed programmatically) -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Generic Error Message (changed programmatically) -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <!-- Search Bar -->
    <div class="search-section mb-4">
        <form method="get" asp-action="Index" id="searchForm">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" id="hiddenSortBy" />
            <input type="hidden" name="category" value="@ViewData["CurrentCategory"]" id="hiddenCategory" />

            <div class="main-search-container">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 search-input"
                    name="search" value="@ViewData["CurrentSearch"]"
                    placeholder="Search for items..."
                    onkeypress="if(event.key==='Enter'){document.getElementById('searchForm').submit();}" />
                    <button type="submit" class="btn btn-primary px-4">Search</button>
                </div>
            </div>
        </form>

        <!-- Filters Button -->
        <div class="text-center mt-3">
            <button type="button" class="btn btn-link text-muted btn-sm"
            onclick="toggleAdvancedFilters()" id="toggleFiltersBtn">
                <i class="fas fa-sliders-h me-1"></i>
                <span id="toggleText">Filters</span>
                <i class="fas fa-chevron-down ms-1" id="toggleIcon"></i>
            </button>
        </div>

        <!-- Advanced Filters Box (this gets expanded) -->
        <div id="advancedFilters" class="mt-3" style="display: none;">
            <div class="card border-0 bg-light">
                <div class="card-body">
                    <form method="get" asp-action="Index" class="row g-3">
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="search" value="@ViewData["CurrentSearch"]" />

                        <!-- Category Filter -->
                        <div class="col-md-4">
                            <label for="category" class="form-label fw-semibold">Category</label>
                            <select class="form-select" id="category" name="category" asp-items='ViewData["Categories"] as SelectList'>
                                <option value="">All Categories</option>
                            </select>
                        </div>

                        <!-- Sort By -->
                        <div class="col-md-4">
                            <label for="sortBy" class="form-label fw-semibold">Sort by</label>
                            <select class="form-select" id="sortBy" name="sortBy">
                                <option value="category" selected="@(ViewData["CurrentSort"]?.ToString() == "category")">Category</option>
                                <option value="name-asc" selected="@(ViewData["CurrentSort"]?.ToString() == "name-asc")">Name (A-Z)</option>
                                <option value="name-desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name-desc")">Name (Z-A)</option>
                                <option value="quantity-desc" selected="@(ViewData["CurrentSort"]?.ToString() == "quantity-desc")">Most Available</option>
                                <option value="quantity-asc" selected="@(ViewData["CurrentSort"]?.ToString() == "quantity-asc")">Least Available</option>
                                @if (PantryPlatoonMVCMain.Util.GlobalFlags.ShowPoints) 
                                {                                
                                    <option value="points-asc" selected="@(ViewData["CurrentSort"]?.ToString() == "points-asc")">Lowest Points</option>
                                    <option value="points-desc" selected="@(ViewData["CurrentSort"]?.ToString() == "points-desc")">Highest Points</option>
                                }
                                <option value="updated" selected="@(ViewData["CurrentSort"]?.ToString() == "updated")">Recently Updated</option>
                            </select>
                        </div>

                        <!-- Apply/Clear Buttons -->
                        <div class="col-md-4 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="fas fa-check me-1"></i>Apply Filters
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Clear
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Active Filters Summary -->
        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CurrentCategory"]?.ToString()) || ViewData["CurrentSort"]?.ToString() != "category")
        {
            <div class="active-filters mt-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <small class="text-muted fw-semibold">Active:</small>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
                    {
                        <span class="badge bg-primary">
                            <i class="fas fa-search me-1"></i>"@ViewData["CurrentSearch"]"
                            <a asp-action="Index" asp-route-category="@ViewData["CurrentCategory"]" asp-route-sortBy="@ViewData["CurrentSort"]"
                               class="text-white ms-1" title="Remove search">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewData["CurrentCategory"]?.ToString()))
                    {
                        <span class="badge bg-info">
                            <i class="fas fa-tag me-1"></i>@ViewData["CurrentCategory"]
                            <a asp-action="Index" asp-route-search="@ViewData["CurrentSearch"]" asp-route-sortBy="@ViewData["CurrentSort"]"
                               class="text-white ms-1" title="Remove category filter">×</a>
                        </span>
                    }
                    @if (ViewData["CurrentSort"]?.ToString() != "category")
                    {
                        <span class="badge bg-info">
                            <i class="fas fa-sort me-1"></i>@GetSortDisplayName(ViewData["CurrentSort"]?.ToString())
                            <a asp-action="Index" asp-route-search="@ViewData["CurrentSearch"]" asp-route-category="@ViewData["CurrentCategory"]" asp-route-sortBy="category"
                               class="text-white ms-1" title="Reset to default sort">×</a>
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="empty-inventory">
                <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                <h4>No inventory found</h4>
                <p class="text-muted">Please adjust your filters, check back later or contact pantry staff for assistance.</p>
            </div>
        </div>
    }
    else
    {

        <!-- Inventory Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 item-card">
                        <div class="item-img-container">
                            <a asp-controller="Inventory" asp-action="Details" asp-route-id="@item.ItemId">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImageUrl" height="200" alt="@item.ItemName" class="item-image" />
                                }
                                else
                                {
                                    <div class="item-placeholder">
                                        <i class="fas fa-box fa-2x"></i>
                                    </div>
                                }
                            </a>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a asp-controller="Inventory" asp-action="Details" asp-route-id="@item.ItemId" class="product-link">@item.ItemName</a>
                            </h5>

                            <p class="card-text text-muted small mb-2">@item.CategoryName</p>

                            <div class="availability-info mb-3">
                                <small class="text-success">
                                    <i class="fas fa-check-circle"></i>
                                    @item.AvailableQuantity available
                                </small>
                                @if (item.Weight > 0)
                                {
                                    <br>
                                    <small class="text-muted">@item.Weight lbs each</small>
                                }
                                @if (PantryPlatoonMVCMain.Util.GlobalFlags.ShowPoints) 
                                {
                                    @if (item.Points > 0)
                                    {
                                        <br>
                                        <small class="text-info">@item.Points points</small>
                                    }
                                }
                            </div>

                            <div class="mt-auto">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="itemId" value="@item.ItemId">

                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text">Qty</span>
                                        <input type="number" name="quantity" value="1" min="1" max="@item.AvailableQuantity" class="form-control">
                                    </div>

                                    <!-- Add Icon with Text -->
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-plus"></i>Add to Bag
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    }

    <!-- Page Controls -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Available items pagination" class="mt-5">
            <ul class="pagination justify-content-center">
                <!-- Previous -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.PageIndex - 1)"
                       aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                <!-- Page Numbers -->
                @{
                    int startPage = Math.Max(1, Model.PageIndex - 2);
                    int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="1">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.PageIndex + 1)"
                       aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="d-flex justify-content-center mt-3">
            <small class="text-muted">
                Showing @(((Model.PageIndex - 1) * 12) + 1) to @(Math.Min(Model.PageIndex * 12, Model.TotalCount))
                of @Model.TotalCount available items
            </small>
        </div>
    }
</div>

@functions {
    string GetSortDisplayName(string? sortBy)
    {
        return sortBy switch
        {
            "name-asc" => "Name A-Z",
            "name-desc" => "Name Z-A",
            "quantity-desc" => "Most Available",
            "quantity-asc" => "Least Available",
            "points-asc" => "Lowest Points",
            "points-desc" => "Highest Points",
            "updated" => "Recently Updated",
            _ => "Category"
        };
    }
}

<script>

    function toggleCampusDropdown() {
        const dropdown = document.getElementById('campusDropdown');
        const chevron = document.getElementById('campusChevron');

        if (dropdown.style.display === 'none' || dropdown.style.display === '') {
            dropdown.style.display = 'block';
            chevron.className = 'fas fa-chevron-up ms-1';
        } else {
            dropdown.style.display = 'none';
            chevron.className = 'fas fa-chevron-down ms-1';
        }
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const campusContainer = document.querySelector('.campus-selector');
        const dropdown = document.getElementById('campusDropdown');
        const chevron = document.getElementById('campusChevron');

        if (!campusContainer.contains(event.target)) {
            dropdown.style.display = 'none';
            chevron.className = 'fas fa-chevron-down ms-1';
        }
    });

    function toggleAdvancedFilters() {
        const filters = document.getElementById('advancedFilters');
        const toggleText = document.getElementById('toggleText');
        const toggleIcon = document.getElementById('toggleIcon');

        if (filters.style.display === 'none') {
            filters.style.display = 'block';
            toggleIcon.className = 'fas fa-chevron-up ms-1';
        } else {
            filters.style.display = 'none';
            toggleIcon.className = 'fas fa-chevron-down ms-1';
        }
    }
</script>

<style>

    .bg-info {
        background-color: var(--brand-color) !important;
    }

    .dropdown-header {
        padding: 12px 12px;
        background-color: #f8f9fa;
        border-bottom: 1px solid #ddd;
        font-size: 0.8rem;
        color: #6c757d;
        border-radius: 8px 8px 0 0;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        width: 100%;
        padding: 12px 16px;
        border: none;
        background: none;
        text-align: left;
        color: #333;
        text-decoration: none;
        transition: background-color 0.2s ease;
        font-size: 0.9rem;
    }

    .item-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border-radius: 8px;
        overflow: hidden;
    }

        .item-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .item-img-container {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8f9fa;
        padding: 10px;
    }

    .item-placeholder {
        color: #6c757d;
        text-align: center;
    }

    .product-link {
        color: #333;
        text-decoration: none;
    }

        .product-link:hover {
            color: #007bff;
            text-decoration: none;
        }

    .availability-info {
        min-height: 50px;
        font-size: 0.875rem;
    }

    .btn-primary {
        background-color: #369044;
        border-color: #369044;
    }

        .btn-primary:hover {
            background-color: #33873F;
            border-color: #33873F;
        }

    .campus-info {
        background-color: #f8f9fa;
        padding: 8px 12px;
        border-radius: 6px;
        border-left: 4px solid #369044;
    }

    .empty-inventory {
        padding: 60px 20px;
        background-color: #f8f9fa;
        border-radius: 12px;
        border: 2px dashed #dee2e6;
    }

    /* Pagination Styling */
    .pagination .page-link {
        color: #369044;
    }

    .pagination .page-item.active .page-link {
        background-color: #2F3867;
        border-color: #2F3867;
    }

    .pagination .page-link:hover {
        color: #33873F;
    }

    /* Input group styling */
    .input-group-sm .input-group-text {
        font-size: 0.875rem;
    }

    .input-group-sm .form-control {
        width: 60px;
    }

    .active-filters {
        padding: 0.75rem;
        background-color: rgba(255, 255, 255, 0.7);
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

</style>