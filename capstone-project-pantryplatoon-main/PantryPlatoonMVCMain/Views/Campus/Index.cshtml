@model IEnumerable<PantryPlatoonMVCMain.Models.Campus>

@{
    ViewData["Title"] = "Campuses";
}

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>
<div class="">
    <div class="card h-100">
        <div class="card-header">Campuses</div>
        <div class="card-body">
            <table id="campusTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Name
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Address)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.CampusName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Address)
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.CampusId" class="btn btn-success">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.CampusId" class="btn btn-success">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.CampusId" class="btn btn-success">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            $('#campusTable').DataTable({
                searching: false,
                pageLength: 25,
                columnDefs: [ //Hide columns from items table (description and points)

                ]
            });
        });
    </script>

}

<style>

    .card-header {
        background-color: #004e8c; /*color picked from scc website*/
        color: white;
    }

</style>
