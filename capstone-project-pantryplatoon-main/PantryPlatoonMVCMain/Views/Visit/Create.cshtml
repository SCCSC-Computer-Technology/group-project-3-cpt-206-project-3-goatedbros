@model PantryPlatoonMVCMain.Models.Visit

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Visit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" class ="form-control" asp-items="ViewBag.UserId"></select>
            </div>
            <div class="form-group">
                <label asp-for="CampusId" class="control-label"></label>
                <select asp-for="CampusId" class ="form-control" asp-items="ViewBag.CampusId"></select>
            </div>
            <div class="form-group">
                <label asp-for="VisitDate" class="control-label"></label>
                <input asp-for="VisitDate" class="form-control" type="date"/>
                <span asp-validation-for="VisitDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalWeight" class="control-label"></label>
                <input asp-for="TotalWeight" class="form-control" type="number" step="0.01" min="0"/>
                <span asp-validation-for="TotalWeight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>            
            <div class="form-group">
                <label asp-for="ScheduledPickupTime" class="control-label"></label>
                <input asp-for="ScheduledPickupTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="ScheduledPickupTime" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <input asp-for="IsScheduledVisit" class="form-check-input" />
                <label asp-for="IsScheduledVisit" class="form-check-label"></label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
