@model PantryPlatoonMVCMain.Models.Visit
@{
    ViewData["Title"] = "Visit Confirmation";
}

<div class="confirmation-container">

    <!-- Main Header -->
    @if (ViewBag.isNewVisit) {
        <div class="text-center mb-5">
            <div class="success-animation">
                <i class="fas fa-check-circle text-success fa-5x mb-3"></i>
            </div>
            <h1 class="display-4 text-success mb-2">Visit Complete!</h1>
            <p class="lead text-muted">Thank you for using the pantry. Your visit has been recorded.</p>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Visit Summary Card -->
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-receipt"></i> Visit Summary
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="text-muted text-uppercase mb-2">Visit Information</h6>
                                <div class="info-item">
                                    <strong>Date:</strong> @Model.VisitDate.ToString("MMMM dd, yyyy")
                                </div>
                                <div class="info-item">
                                    <strong>Visit ID:</strong> #@Model.VisitId.ToString("D6")
                                </div>
                                @if (Model.Campus != null)
                                {
                                    <div class="info-item">
                                        <strong>Campus:</strong> @Model.Campus.CampusName
                                    </div>
                                }
                                @if (Model.User != null)
                                {
                                    <div class="info-item">
                                        <strong>Student:</strong> @Model.User.FullName
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="text-muted text-uppercase mb-2">Visit Totals</h6>
                                <div class="info-item">
                                    <strong>Total Items:</strong>
                                    <span class="badge bg-primary fs-6">@Model.VisitItems.Sum(vi => vi.QuantityTaken)</span>
                                </div>
                                @if (Model.TotalWeight > 0)
                                {
                                    <div class="info-item">
                                        <strong>Total Weight:</strong>
                                        <span class="text-info">@Model.TotalWeight lbs</span>
                                    </div>
                                }
                                @if (PantryPlatoonMVCMain.Util.GlobalFlags.ShowPoints)
                                {
                                    @if (Model.VisitItems.Any(vi => vi.Item?.Points > 0))
                                    {
                                        <div class="info-item">
                                            <strong>Points Used:</strong>
                                            <span class="text-warning">
                                                <i class="fas fa-star"></i> @Model.VisitItems.Sum(vi => (vi.Item?.Points ?? 0) * vi.QuantityTaken)
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Card -->
            <div class="card shadow-lg mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> Items Taken
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Category</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-center">Weight</th>
                                    <th class="text-center">Points</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var visitItem in Model.VisitItems.OrderBy(vi => vi.Item?.ItemCategory?.ItemCategoryName).ThenBy(vi => vi.Item?.ItemName))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="item-icon me-3">
                                                    <i class="fas fa-box text-muted"></i>
                                                </div>
                                                <div>
                                                    <strong>@visitItem.Item?.ItemName</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @visitItem.Item?.ItemCategory?.ItemCategoryName
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="fw-bold">@visitItem.QuantityTaken</span>
                                        </td>
                                        <td class="text-center">
                                            @if (visitItem.Item?.Weight > 0)
                                            {
                                                <span class="text-muted">
                                                    @(((decimal)(visitItem.Item.Weight * visitItem.QuantityTaken)).ToString("F1")) lbs
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (visitItem.Item?.Points > 0)
                                            {
                                                <span class="text-warning">
                                                    <i class="fas fa-star"></i> @((visitItem.Item.Points * visitItem.QuantityTaken))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Important Information Card -->
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i> Important Information
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.VisitInfoContent))
                    {
                        @Html.Raw(ViewBag.VisitInfoContent)
                    }
                    else
                    {
                        <!-- Fallback content if no static page exists -->
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-primary">Food Safety Reminders</h6>
                                <ul class="reminder-list">
                                    <li>Check expiration dates on all items</li>
                                    <li>Refrigerate perishable items promptly</li>
                                    <li>Store items in a clean, dry place</li>
                                    <li>Follow cooking instructions for prepared foods</li>
                                </ul>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-3 p-3 bg-light rounded">
                            <h6 class="text-muted mb-2">Visit Notes:</h6>
                            <p class="mb-0 small">@Model.Notes</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-center mb-5">
                <div class="d-flex flex-column flex-md-row gap-3 justify-content-center">
                    <a asp-controller="Inventory" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="fas fa-search"></i> Browse More Items
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-home"></i> Return Home
                    </a>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-3">Need Help or Have Questions?</h6>
                    <p class="mb-2">
                        <i class="fas fa-envelope text-primary"></i>
                        Contact us at <a href="mailto:pantry@scc.edu">pantry@scc.edu</a>
                    </p>
                    <p class="mb-0">
                        <i class="fas fa-clock text-primary"></i>
                        Pantry Hours: Monday - Friday, 9:00 AM - 4:00 PM
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .confirmation-container {
        padding: 40px 0;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .success-animation {
        animation: bounceIn 0.8s ease-out;
    }

    .card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: none;
        padding: 20px 25px;
    }

    .card-body {
        padding: 25px;
    }

    .info-section {
        margin-bottom: 20px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #f1f1f1;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .item-icon {
        width: 40px;
        height: 40px;
        background-color: #f8f9fa;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .reminder-list {
        padding-left: 20px;
        margin-bottom: 0;
    }

        .reminder-list li {
            margin-bottom: 8px;
            color: #6c757d;
        }

    .table td {
        vertical-align: middle;
        padding: 15px 10px;
    }

    .badge {
        font-size: 0.8rem;
        padding: 6px 10px;
    }

    .btn-lg {
        padding: 12px 24px;
        font-size: 1.1rem;
        border-radius: 8px;
    }

    .fade-in {
        animation: fadeInUp 0.6s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add animations to cards
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
                card.classList.add('fade-in');
            });
        });
    </script>

    <style>
        @@keyframes bounceIn {
            0% {
                transform: scale(0.3);
                opacity: 0;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.8;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Print styles */
        @@media print {
            .confirmation-container {
                background: white !important;
                padding: 20px !important;
            }

            .card {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
            }

            .btn, .card-header {
                display: none !important;
            }

            .success-animation {
                animation: none !important;
            }
        }

        /* Mobile responsiveness */
        @@media (max-width: 768px) {
            .confirmation-container {
                padding: 20px 0;
            }

            .display-4 {
                font-size: 2rem;
            }

            .info-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 5px;
            }

            .table-responsive {
                font-size: 0.9rem;
            }
        }
    </style>
}