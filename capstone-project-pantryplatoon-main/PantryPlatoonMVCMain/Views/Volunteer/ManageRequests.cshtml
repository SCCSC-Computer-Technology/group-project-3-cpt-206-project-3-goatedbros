@model IEnumerable<PantryPlatoonMVCMain.Models.VolunteerRequest>

@{
    ViewData["Title"] = "Manage Volunteer Requests";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-user-clock text-warning me-2"></i>Pending Volunteer Requests</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Schedule
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm p-5 text-center">
            <i class="fas fa-check-circle fa-3x mb-3 text-info"></i>
            <h3>All caught up!</h3>
            <p class="mb-0 text-muted">There are no new volunteer requests to review at this time.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-warning">
                        <tr>
                            <th>Volunteer Name</th>
                            <th>Requested Date</th>
                            <th>Hours</th>
                            <th>Proposed Tasks</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.VolunteerName</td>
                                <td>@item.RequestedDate.ToShortDateString()</td>
                                <td>@item.HoursRequested hrs</td>
                                <td>@item.JobDescription</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <form asp-action="ApproveRequest" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm px-3">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>

                                        <form asp-action="DisapproveRequest" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm px-3"
                                                    onclick="return confirm('Are you sure you want to decline and delete this request?');">
                                                <i class="fas fa-times"></i> Decline
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts 
{
    <script>
       
        $(document).ready(function () 
        {
            setTimeout(function () 
            {
                $(".alert").fadeOut('slow');
            }, 3000);
        });
    </script>
}
