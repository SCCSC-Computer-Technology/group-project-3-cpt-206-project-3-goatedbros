@model PantryPlatoonMVCMain.Models.VolunteerShift

@{
    ViewData["Title"] = "Schedule Volunteer";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Schedule New Volunteer Shift</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="VolunteerName" class="form-label font-weight-bold"></label>
                            <input asp-for="VolunteerName" class="form-control" placeholder="Enter volunteer's full name" />
                            <span asp-validation-for="VolunteerName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ShiftDate" class="form-label font-weight-bold"></label>
                                <input asp-for="ShiftDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ShiftDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoursTracked" class="form-label font-weight-bold">Hours to Work</label>
                                <input asp-for="HoursTracked" class="form-control" type="number" step="0.5" min="0" max="24" />
                                <span asp-validation-for="HoursTracked" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TaskDescription" class="form-label font-weight-bold">Assigned Tasks</label>
                            <textarea asp-for="TaskDescription" class="form-control" rows="3" placeholder="Describe the duties for this shift..."></textarea>
                            <span asp-validation-for="TaskDescription" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i> Save Schedule
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}