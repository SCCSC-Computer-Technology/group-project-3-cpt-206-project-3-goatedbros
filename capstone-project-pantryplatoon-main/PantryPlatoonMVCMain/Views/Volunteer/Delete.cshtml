@model PantryPlatoonMVCMain.Models.VolunteerShift

@{
    ViewData["Title"] = "Delete Shift";
}

<div class="container mt-4">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h3>Are you sure you want to delete this shift?</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Volunteer</dt>
                <dd class="col-sm-9">@Model.VolunteerName</dd>
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.ShiftDate.ToShortDateString()</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>