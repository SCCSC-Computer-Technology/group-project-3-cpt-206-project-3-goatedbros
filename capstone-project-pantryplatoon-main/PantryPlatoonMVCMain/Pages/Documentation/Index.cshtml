@page
@model PantryPlatoonMVCMain.Pages.Documentation.IndexModel
@{
    ViewData["Title"] = "Documentation";
    Layout = "_Layout";
}
<style>
    .documentation-hero {
        background: linear-gradient(135deg, #2f3f78, #23315f);
        color: white;
        border-radius: 14px;
        padding: 2.25rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12);
    }
    .documentation-hero h1 {
        font-weight: 700;
        margin-bottom: 0.4rem;
    }
    .documentation-hero p {
        margin-bottom: 0;
        font-size: 1.05rem;
        opacity: 0.95;
    }
    .doc-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }
    .doc-card .card-header {
        background-color: #2f3f78;
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
        padding: 1rem 1.25rem;
    }
    .doc-card .card-body {
        padding: 1.5rem;
    }
    .form-label {
        font-weight: 600;
        color: #24304f;
    }
    .form-control {
        border-radius: 9px;
        padding: 0.65rem 0.85rem;
    }
    .form-control:focus {
        border-color: #2f3f78;
        box-shadow: 0 0 0 0.2rem rgba(47, 63, 120, 0.18);
    }
    .btn-pantry {
        background-color: #2f3f78;
        border-color: #2f3f78;
        color: white;
        border-radius: 9px;
        padding: 0.65rem 1.15rem;
        font-weight: 600;
    }
    .btn-pantry:hover {
        background-color: #24315f;
        border-color: #24315f;
        color: white;
    }
    .report-stat {
        background-color: #f4f6fb;
        border-left: 5px solid #2f3f78;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
    }
    .report-stat h5 {
        margin: 0;
        color: #24304f;
        font-weight: 700;
    }
    .documentation-table thead {
        background-color: #eef1f8;
        color: #24304f;
    }
    .documentation-table th {
        white-space: nowrap;
        font-size: 0.92rem;
    }
    .documentation-table td {
        vertical-align: middle;
        font-size: 0.94rem;
    }
    .empty-docs {
        background-color: #f8f9fc;
        border: 1px dashed #c8cedd;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        color: #5f6677;
    }
    .file-help-text {
        font-size: 0.9rem;
        color: #6c757d;
    }
    .action-buttons {
        white-space: nowrap;
    }
</style>
<div class="container mt-5 mb-5">
    <div class="documentation-hero">
        <h1>Documentation</h1>
        <p>Upload, store, and manage pantry files, reports, and reference documents.</p>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card doc-card h-100">
                <div class="card-header">
                    Upload New Document
                </div>
                <div class="card-body">
                    <form method="post" action="/Documentation?handler=Upload" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Document Title</label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Example: Pantry Rules Form"
                                   required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Add a short description of what this document is for."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Choose File</label>
                            <input asp-for="UploadedFile"
                                   type="file"
                                   class="form-control"
                                   required />
                            <div class="file-help-text mt-2">
                                Allowed files: PDF, Word, TXT, PNG, JPG, JPEG
                            </div>
                        </div>
                        <button type="submit" class="btn btn-pantry w-100 mt-2">
                            Upload Document
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card doc-card h-100">
                <div class="card-header">
                    Documentation Report
                </div>
                <div class="card-body">
                    <div class="report-stat">
                        <h5>Total Documents Uploaded: @(Model.Documents?.Count ?? 0)</h5>
                    </div>
                    @if (Model.Documents == null || !Model.Documents.Any())
                    {
                        <div class="empty-docs">
                            <h5 class="mb-2">No documents uploaded yet</h5>
                            <p class="mb-0">
                                Uploaded files will appear here once they are added.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered documentation-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Original File</th>
                                        <th>Type</th>
                                        <th>Size</th>
                                        <th>Uploaded By</th>
                                        <th>Uploaded At</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.Documents)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@doc.Title</td>
                                            <td>@doc.Description</td>
                                            <td>@doc.OriginalFileName</td>
                                            <td>@doc.ContentType</td>
                                            <td>@Model.FormatFileSize(doc.FileSizeBytes)</td>
                                            <td>@doc.UploadedBy</td>
                                            <td>@doc.UploadedAt.ToString("MM/dd/yyyy h:mm tt")</td>
                                            <td class="action-buttons">
                                                <a href="@doc.FilePath"
                                                       target="_blank"
                                                       class="btn btn-sm btn-outline-primary me-1">
                                                    View
                                                </a>
                                                <form method="post"
                                                      asp-page-handler="Delete"
                                                      asp-route-id="@doc.DocumentationUploadId"
                                                      class="d-inline">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to delete this document?');">
                                                        Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>