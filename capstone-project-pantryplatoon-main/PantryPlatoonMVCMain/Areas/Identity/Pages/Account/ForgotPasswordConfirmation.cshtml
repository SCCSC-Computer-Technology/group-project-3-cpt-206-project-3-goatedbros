@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="text-center mt-5">
    <h2 class="text-success">Password Reset Link Sent</h2>
    <p class="lead">
        If your email is registered, you'll receive a password reset link shortly.
    </p>

    <p class="text-muted">
        Didn't receive an email or need help?
        <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary btn-sm mx-1">Contact IT Helpdesk</a>
    </p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to Home</a>
</div>